itions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":571.21,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":656.89,\"currency\":\"USD\",\"source\":\"\"}],\"initialPrice\":[{\"amount\":571.21,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-19 10:00:00\",\"amount\":190.4,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-25 10:00:00\",\"amount\":380.81,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":571.21,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":571.21,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":656.89,\"currency\":\"USD\",\"source\":\"\"},\"offerInitialPrice\":{\"amount\":571.21,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":