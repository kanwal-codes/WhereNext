\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":897.77,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":1176.08,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":897.77,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3TKOJNGEZTKMZUGN6FERSOPQZDAMRWGEYDCMRRGAYDA7BSPRJDCMZQGZ6DQOJZG4ZQ\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Classic Double or Twin Room\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"HB\",\"boardName\":\"Half Board\",\"remarks\":\"\\u003cp\\u003e\\u003cstrong\\u003ePlease be informed that Hotel Mundial will be undergoing renovation works until November 2028.\\u003c/p\\u003e\\u003cbr/\\u003eHalf Board is menu of the day at the Varanda de Lisboa Restaurant. Jardim Mundial Restaurant is closed for lunch/dinner meals.\\u003cbr/\\u003eEBD - Are not applicable to groups. Not cumulative with other offers\\u003cbr/\\u003eBirthday guests and Honeymooners - Offer of a bottle of sparkling wine and petit fours. Honeymoonner guests must present a marriage certificate.\\u003cbr/\\u003eNon smoking Hotel.\\u003cbr/\\u003ePHC Hotels has a new app through which you can pre-check in and take advantage of all hotel services. Download PHC Hotels App from App Store (https://apps.apple.com/us/app/id1523449661) or Play Store (https://play.google.com/store/apps/details?id=com.guestu.phchotels)\\u003cbr/\\u003eNo-Show Fee: 100% charged.\\u003cbr/\\u003eParking € 15.00 per day, subject to Hotel availability.\\u003cbr/\\u003eCheck-in is available from 3pm.\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":899.73,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":1175.04,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":899.73,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-12 10:00:00\",\"amount\":899.73,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":899.73,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":899.73,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":1175.04,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":899.73,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3TKOJNGEZTKMZUGN6E4USGJZ6DEMBSGYYDSMJUGEYDAMD4GE3XYURRGMYDM7BZGA4TGNY\",\"offerId\":\"-\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Standard Triple Room - NRF\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"\\u003cp\\u003e\\u003cstrong\\u003ePlease be informed that Hotel Mundial will be undergoing renovation works until November 2028.\\u003c/p\\u003e\\u003cbr/\\u003eAs of 1st January 2019 and according to information of the Lisbon City Hall, city tax will be increased. It will continue to be charged per guest (13+ years old) until a maximum of 7 nights. The present rates do not include this tax, which shall be paid directly by the guest to the hotel.\\u003cbr/\\u003ePHC Hotels has a new app through which you can pre-check in and take advantage of all hotel services. Download PHC Hotels App from App Store (https://apps.apple.com/us/app/id1523449661) or Play Store (https://play.google.com/store/apps/details?id=com.guestu.phchotels)\\u003cbr/\\u003eNo Show Fee: 100% charged.\\u003cbr/\\u003eCheck-in is available from 3pm.\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":909.37,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":1187.63,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":909.37,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 yea