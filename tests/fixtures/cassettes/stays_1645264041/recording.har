":[],\"hotelRemarks\":[],\"refundableTag\":\"NRFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":852.78,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":1056.59,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":852.78,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"standard\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3TKOJNGEZTKMZUGN6FERSOPQZDAMRWGEYDENBRGAYDA7BRGR6FEMJTGA3HYOBVGU3TG\",\"offerId\":\"-\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Classic Room with Extra Bed\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"\\u003cp\\u003e\\u003cstrong\\u003ePlease be informed that Hotel Mundial will be undergoing renovation works until November 2028.\\u003c/p\\u003e\\u003cbr/\\u003eAs of 1st January 2019 and according to information of the Lisbon City Hall, city tax will be increased. It will continue to be charged per guest (13+ years old) until a maximum of 7 nights. The present rates do not include this tax, which shall be paid directly by the guest to the hotel.\\u003cbr/\\u003ePHC Hotels has a new app through which you can pre-check in and take advantage of all hotel services. Download PHC Hotels App from App Store (https://apps.apple.com/us/app/id1523449661) or Play Store (https://play.google.com/store/apps/details?id=com.guestu.phchotels)\\u003cbr/\\u003eNo Show Fee: 100% charged.\\u003cbr/\\u003eCheck-in is available from 3pm.\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":855.73,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":1117.59,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":855.73,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-24 10:00:00\",\"amount\":285.24,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":855.73,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":855.73,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":1117.58,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":855.73,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3DGNBNGEZTKMZUGN6FERSOPQZDAMRWGEYDENBRGAYDA7BRGN6FEMJSGM4XYOBWGQ2TK\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Classic Room with extra bed (Child)\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"Starting on 01st July of 2024, hotel will have renovations works that will affect, in phases, different areas of the building: Phase 1 July to November 2024, Ground Floor. Phase 2 Nov 2024 to Mar 2025 Restaurants, Terrace, Meeting Rooms and Gym, Phase 3 from 2025 to 2027 Guest Rooms. To minimize the impact works will take place mon to sat 10:00 am to 6:00 pm only\\u003cbr/\\u003e5 rooms or more for the same dates will be considered as a group, and the hotel will have the right to reject it or to confirm them at different rates and conditions.Group reservations are considered to be those reservations or blocks made by the agency for 5 rooms or more, having the same or several locations/origin, with identical creation date or made on different dates and the dates of stay of the reservations coincide on several or all days. Therefore, in these situations, the hotel reserves the right not to accept these reservations, being necessary to confirm the price and availability of these rooms expressly by the hotel and after the quotation of availability and prices through the group department.\\u003cbr/\\u003eTourist City taxes and Resort Fees to be paid on the spot, if any\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":864.55,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":1071.18,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":864.55,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"City tax\",\"amount\":27.6,\"currency\":\"USD\"},{\"included\":false,\"description\":\"VAT\",\"amount\":51.87,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"ca