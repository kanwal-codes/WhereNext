\"suggestedSellingPrice\":[{\"amount\":979.39,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":839.96,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"VAT\",\"amount\":50.4,\"currency\":\"USD\"},{\"included\":false,\"description\":\"City tax\",\"amount\":27.6,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-11 10:00:00\",\"amount\":839.96,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":839.96,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":839.96,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":979.39,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":839.96,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"standard\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GY3DQLJSG4ZTQMJQPRJEMTT4GIYDENRRGAYTCMJQGAYHYN34KIYTCNRWPQ4DINBSGQ\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"DOBLE\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"A group is considered from 9 rooms onwards, with Vincci Hotels reserving the right to apply the group policy, as well as request deposits, if required.\\n\\nA group is considered from 5 rooms onwards for the following Vincci Hotels: Vincci Puertochico, Vincci Selección Aleysa, Vincci Selección Rumaykiyya, Vincci Larios, and Vincci Selección Unuk. Vincci Hotels reserves the right to apply the group policy, as well as request deposits, if required.\\u003cbr/\\u003eCribs are available upon request\\u003cbr/\\u003eReservas/Reservations \\n\\nEstimado colaborador, \\nNos gustaría informarles sobre nuestra política en relación con posibles errores de sistema en las reservas que puedan ocurrir en el futuro, no relacionados con Hyperguest. \\nEl hotel se reservará el derecho a cancelar cualquier reserva realizada con una tarifa publicada erróneamente debido a errores técnicos evidentes o problemas del sistema. En caso de cancelación, se informará al cliente lo antes posible y se ofrecerá una solución alternativa.\\nNuestro objetivo es minimizar cualquier inconveniente para los clientes y ofrecer una solución rápida y adecuada, buscando alternativas viables. Apreciamos su colaboración en la gestión de estos posibles incidentes y en garantizar la mejor experiencia para los clientes.\\nGracias por su comprensión y apoyo. \\nAtentamente\\n--------\\nDear Partner,\\nWe would like to inform you about our policy regarding potential system errors in bookings that may occur in the future, not related with Hyperguest. \\nThe hotel reserves the right to cancel any booking made with an incorrectly published rate due to obvious technical errors or system issues. In the event of a cancellation, the customer will be informed as soon as possible and an alternative solution will be offered.\\nOur goal is to minimize any inconvenience to customers and provide a quick and appropriate solution by seeking viable alternatives. We appreciate your collaboration in managing these potential incidents and ensuring the best experience for our customers.\\nThank you for your understanding and support. \\nSincerely\\u003cbr/\\u003eFor the entire Vincci Hotels chain, the no-show policy is 100% of the total reservation amount and total charges.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":844.24,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":984.38,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":844.24,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":true,\"description\":\"VAT of 6% per room per night (Included in price)\",\"amount\":47.77,\"currency\":\"USD\"},{\"included\":false,\"description\":\"City Tax (Lisbon Municipal Tourist Tax) of 4 EUR per person per night (Not included in price)\",\"amount\":27.72,\"currency\":\"USD\"},{\"included\":false,\"description\":\"TASA TURISTICA of 2 EUR per person per night (Not included in price)\",\"amount\":13.86,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-11 10:00:00\",\"amount\":844.24,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":844.24,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null,\"rateCode\":\"BB\"}],\"offerRetailRate\":{\"amount\":844.24,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":984.38,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":844.24,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE4TGNJNGI3TGOBRGB6FERSOPQZDAMRWGEYDCMJQHE2TS7BRGJ6FEMJRGY3HYOBUGQZDK\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Vincci Room\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":844.25,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":984.39,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":844.25,\"currency\":\"USD\"}],\"taxesAndFees\"