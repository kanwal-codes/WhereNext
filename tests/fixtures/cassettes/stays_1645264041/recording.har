\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":1207.5,\"currency\":\"USD\",\"source\":\"\"}],\"initialPrice\":[{\"amount\":1050,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":true,\"description\":\"$82.86 USD per room per stay\",\"amount\":85.16,\"currency\":\"USD\"},{\"included\":false,\"description\":\"$27.74 USD per room per stay\",\"amount\":27.74,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[],\"hotelRemarks\":[],\"refundableTag\":\"NRFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":1050,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":1207.5,\"currency\":\"USD\",\"source\":\"\"},\"offerInitialPrice\":{\"amount\":1050,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"standard\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3TKOJNGM2DEMRYGB6E4USGJZ6DEMBSGYYDSMJUGEYDAMD4G56FEMJQGAYHYMJQGU2DINY\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Superior Room BB - NR15BB10 - Non Refundable 15D BB 10%\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"Please note that the hotel reserves the right to request at check-in the credit card used for the reservation. If the credit card does not match the person registered in the reservation, a new payment will be requested. \\u003cbr/\\u003eAs of 1st January 2019 and according to information of the Lisbon City Hall, city tax will be increased. It will continue to be charged per guest (13+ years old) until a maximum of 7 nights. The present rates do not include this tax, which shall be paid directly by the guest to the hotel.\\u003cbr/\\u003eNo Show Fee: 100% Charged\\u003cbr/\\u003eThe shuttle service is available between Altis Avenida and Altis Belem \\u0026 Spa, upon avai