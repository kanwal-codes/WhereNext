rged.\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":680.4,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":762.05,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":680.4,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[],\"hotelRemarks\":[],\"refundableTag\":\"NRFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":680.4,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":762.05,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":680.4,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GEZDENJNGM2TMNZQHF6E4USGJZ6DEMBSGYYDSMJUGEYDAMD4GR6FEMJRGIYHYNRYGQ2TA\",\"offerId\":\"-hY6NVU0SibHDAo2JrdAA=\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"TWIN ROOM\",\"maxOccupancy\"