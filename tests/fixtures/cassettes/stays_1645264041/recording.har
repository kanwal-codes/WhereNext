second, third or fourth pax, wont be accepted for further modification, even if the reservation already has a legal first name.\\u003cbr/\\u003eAs of 1st January 2019 and according to information of the Lisbon City Hall, city tax will be increased. It will continue to be charged per guest (13+ years old) until a maximum of 7 nights. The present rates do not include this tax, which shall be paid directly by the guest to the hotel.\\u003cbr/\\u003eThe outdoor swimming pool is opened from April to October from 10 am to 08 pm.\\u003cbr/\\u003eWe inform that all room have coffee and tea machine. The first 2 capsules are complimentary, extra are available at a cost.\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":442.65,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":498.87,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":442.65,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[],\"hotelRemarks\":[],\"refundableTag\":\"NRFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":442.65,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":498.87,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":442.65,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3TKOJNGIYTOOJRHB6E4USGJZ6DEMBSGYYDSMJUGEYDAMD4GZ6FEMJRGI3XYNBUGI3DK\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Studio Double BB - Non Refundable\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"Any type of fare does not allow changes of names. For that changing the reservation should be cancelled and a new one has to be made. All reservations must have a real Guest name. Fictional names or TBA/TBA for the second, third or fourth pax, wont be accepted for further modification, even if the reservation already has a legal first name.\\u003cbr/\\u003eAs of 1st January 2019 and according to information of the Lisbon City Hall, city tax will be increased. It will continue to be charged per guest (13+ years old) until a maximum of 7 nights. The present rates do not include this tax, which shall be paid directly by the guest to the hotel.\\u003cbr/\\u003eThe outdoor swimming pool is opened from April to October from 10 am to 08 pm.\\u003cbr/\\u003eWe inform that all room have coffee and tea machine. The first 2 capsules are complimentary, extra are available at a cost.\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":442.65,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":498.87,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":442.65,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[],\"hotelRemarks\":[],\"refundableTag\":\"NRFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":442.65,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":498.87,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":442.65,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GEZDENBNGIYTOOJRHB6FERSOPQZDAMRWGEYDENBRGAYDA7BTPRJDCMJSG56DINBTGMZQ\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"ESTUDIO TWIN ROOM\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"RO\",\"boardName\":\"Room Only\",\"remarks\":\"\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":443.33,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":499.63,\"currency\":\"