 the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":744.1,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":773.12,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":744.1,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-23 10:00:00\",\"amount\":744.1,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":744.1,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":744.1,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":773.12,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":744.1,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"package\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GEZDENBNGM2TOMBYGR6FERSOPQZDAMRWGEYDEMZRGAYDA7BSPRJDCMBTHF6DONBXGQYQ\",\"offerId\":\"-kbXJpZMCjbXJuwKNoZHDAo2ZybqCjc3JurlNVUEVSSU9SIFNVSVRFo29jbgGkcHJrc8CjZGV0ywAAAAAAAAAAomNwgqFwkYWhdLMyMDI2LTEwLTIzIDEwOjAwOjAwoWHLQIdbR64UeuGhY6NVU0SidHmmYW1vdW50onR6o0dNVKJydKNSRk6kc2hpZKYzNTcwODSjc2lkAqNoaWSnbHA1NzJkY6NvY2ORgaFhAqNjdXKjVVNEomduolVTomNpqjIwMjYtMTAtMjeiY2-qMjAyNi0xMC0zMKNnaWSgomNyywAAAAAAAAAApHNzaWTZMHNlc3Npb25fMDFhMGE1ZjM1MGI3RVFyS3pGaENrdzdjcXdhd1owd2t3N0RXQ215Q6Npc2jCo3NzcKtib29raW5nL