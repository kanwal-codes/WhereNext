d\":\"\",\"occupancyNumber\":1,\"name\":\"Standard Room\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":840.43,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":937.92,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":840.43,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"City tax\",\"amount\":27.6,\"currency\":\"USD\"},{\"included\":false,\"description\":\"VAT\",\"amount\":50.43,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-18 10:00:00\",\"amount\":840.43,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":840.43,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":937.92,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":840.43,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"standard\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3TKOJNGY2TINZZGR6FERSOPQZDAMRWGEYDCOJRGAYDA7BUPRJDCMJRGZ6DQNBRGQZQ\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Double Standard Room BB\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"BI\",\"boardName\":\"Breakfast Included\",\"remarks\":\"City tax not included. Paid Directly at the hotel\\u003cbr/\\u003eAs of 1st January 2019 and according to information of the Lisbon City Hall, city tax will be increased. It will continue to be charged per guest (13+ years old) until a maximum of 7 nights. The present rates do not include this tax, which shall be paid directly by the guest to the hotel.\\u003cbr/\\u003eCheck-in available from 3 p.m. until March 31, 2026. From April 1 to November 15, 2026, only available from 4 p.m.\\u003cbr/\\u003eBooking considered as group when booked more than 4 rooms.\\u003cbr/\\u003eNew breakfast hours: 07:30am to 11 am\\u003cbr/\\u003e\\u003cspan style=\\\"font-size:1.1em;\\\"\\u003e  \\u003cstrong\\u003e\\u003cspan style=\\\"color:red;\\\"\\u003eIMPORTANT \\u0026#128308;\\u003c/span\\u003e \\u003cspan style=\\\"color:red;\\\"\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003c/span\\u003e\\u003c/strong\\u003e\\u003c/span\\u003e\\u003cbr/\\u003eRates and conditions valid only for individual bookings. 3 or more rooms will be considered group and rates/conditions may change.\\u003cbr/\\u003eThe hotel may charge City Taxes or a Resort Fee, paid directly at the hotel\\u003cbr/\\u003eBaby cot subject to availability and may have an additional cost.\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003eDouble/Twin beds are subject to hotel availability.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":841.43,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":939.03,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":841.43,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"As per information of the local authorities, city tax will be charged  in Lisbon, 4€ per night and per person with more than 13 years, up to a maximum of 7 nights. Tax to be paid directly at the hotel (subject to change)\",\"amount\":27.72,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelP