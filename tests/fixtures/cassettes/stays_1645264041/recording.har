er\":1,\"name\":\"Vincci Room\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"RO\",\"boardName\":\"Room Only\",\"remarks\":\"5 rooms or more for the same dates will be considered as a group, and the hotel will have the right to reject it or to confirm them at different rates and conditions.Group reservations are considered to be those reservations or blocks made by the agency for 5 rooms or more, having the same or several locations/origin, with identical creation date or made on different dates and the dates of stay of the reservations coincide on several or all days. Therefore, in these situations, the hotel reserves the right not to accept these reservations, being necessary to confirm the price and availability of these rooms expressly by the hotel and after the quotation of availability and prices through the group department.\\u003cbr/\\u003eTourist City taxes and Resort Fees to be paid on the spot, if any\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":671.01,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":782.4,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":671.01,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"VAT\",\"amount\":40.26,\"currency\":\"USD\"},{\"included\":false,\"description\":\"City tax\",\"amount\":27.6,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-11 10:00:00\",\"amount\":671.01,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":671.01,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":671.01,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":782.4,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":671.01,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"standard\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GE3DSOBNGI3TGOBRGB6FERSOPQZDAMRWGEYDCMJRGAYDA7BRPRJDCMJWGZ6DMNZRGAYQ\",\"offerId\":\"-BR64UeupW9yX3ByywAAAAAAAAAApW9yX2NtywAAAAAAAAAAomNtywAAAAAAAAAAo3BjZLMyMDI2LTEwLTI2IDEwOjAwOjAwonJ0o1JGTqNicmSiUk--\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"Vincci Room\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"RO\",\"boardName\":\"Room Only\",\"remarks\":\"5 rooms or more for the same dates will be considered as a group, and the hotel will have the right to reject it or to confirm them at different rates and conditions.Group reservations are considered to be those reservations or blocks made by the agency for 5 rooms or more, having the same or several locations/origin, with identical creation date or made on different dates and the dates of stay of the reservations coincide on several or all days. Therefore, in these situations, the hotel reserves the right not to accept these reservations, being necessary to confirm the price and availability of these rooms expressly by the hotel and after the quotation of availability and prices through the group department.\\u003cbr/\\u003eTourist City taxes and Resort Fees to be paid on the spot, if any\\u003cbr/\\u003eNote that some hotels may require cash or credit card deposit as guarantee. This will be returned on departure minus any deduction incurred during the stay.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":671.01,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":782.4,\"currency\":\"USD\",\"source\":\"booking.com\"}],\"initialPrice\":[{\"amount\":671.01,\"currency\":\"USD\"}],\"taxesAndFees\":[{\"included\":false,\"description\":\"VAT\",\"amount\":40.26,\"currency\":\"USD\"},{\"included\":false,\"description\":\"City tax\",\"amount\":27.6,\"currency\":\"USD\"}]},\"cancellationPolicies\":{\"cancelPolicyInfos\":[{\"cancelTime\":\"2026-10-11 10:00:00\",\"amount\":671.01,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"},{\"cancelTime\":\"2026-10-26 10:00:00\",\"amount\":671.01,\"currency\":\"USD\",\"type\":\"amount\",\"timezone\":\"GMT\"}],\"hotelRemarks\":[],\"refundableTag\":\"RFN\"},\"paymentTypes\":[\"NUITEE_PAY\"],\"providerCommission\":{\"amount\":0,\"currency\":\"\"},\"perks\":[],\"promotions\":null}],\"offerRetailRate\":{\"amount\":671.01,\"currency\":\"USD\"},\"suggestedSellingPrice\":{\"amount\":782.4,\"currency\":\"USD\",\"source\":\"booking.com\"},\"offerInitialPrice\":{\"amount\":671.01,\"currency\":\"USD\"},\"priceType\":\"commission\",\"rateType\":\"standard\",\"paymentTypes\":[\"NUITEE_PAY\"]},{\"roomTypeId\":\"GY3DQLJSG4ZTQMJQPRJEMTT4GIYDENRRGAYTCMJQGAYHYOL4KIYTCNRWPQ3DONBYHE\",\"offerId\":\"\",\"supplier\":\"nuitee\",\"supplierId\":2,\"rates\":[{\"rateId\":\"\",\"occupancyNumber\":1,\"name\":\"DOBLE\",\"maxOccupancy\":2,\"adultCount\":2,\"childCount\":0,\"childrenAges\":[],\"boardType\":\"RO\",\"boardName\":\"Room Only\",\"remarks\":\"A group is considered from 9 rooms onwards, with Vincci Hotels reserving the right to apply the group policy, as well as request deposits, if required.\\n\\nA group is considered from 5 rooms onwards for the following Vincci Hotels: Vincci Puertochico, Vincci Selección Aleysa, Vincci Selección Rumaykiyya, Vincci Larios, and Vincci Selección Unuk. Vincci Hotels reserves the right to apply the group policy, as well as request deposits, if required.\\u003cbr/\\u003eCribs are available upon request\\u003cbr/\\u003eReservas/Reservations \\n\\nEstimado colaborador, \\nNos gustaría informarles sobre nuestra política en relación con posibles errores de sistema en las reservas que puedan ocurrir en el futuro, no relacionados con Hyperguest. \\nEl hotel se reservará el derecho a cancelar cualquier reserva realizada con una tarifa publicada erróneamente debido a errores técnicos evidentes o problemas del sistema. En caso de cancelación, se informará al cliente lo antes posible y se ofrecerá una solución alternativa.\\nNuestro objetivo es minimizar cualquier inconveniente para los clientes y ofrecer una solución rápida y adecuada, buscando alternativas viables. Apreciamos su colaboración en la gestión de estos posibles incidentes y en garantizar la mejor experiencia para los clientes.\\nGracias por su comprensión y apoyo. \\nAtentamente\\n--------\\nDear Partner,\\nWe would like to inform you about our policy regarding potential system errors in bookings that may occur in the future, not related with Hyperguest. \\nThe hotel reserves the right to cancel any booking made with an incorrectly published rate due to obvious technical errors or system issues. In the event of a cancellation, the customer will be informed as soon as possible and an alternative solution will be offered.\\nOur goal is to minimize any inconvenience to customers and provide a quick and appropriate solution by seeking viable alternatives. We appreciate your collaboration in managing these potential incidents and ensuring the best experience for our customers.\\nThank you for your understanding and support. \\nSincerely\\u003cbr/\\u003eFor the entire Vincci Hotels chain, the no-show policy is 100% of the total reservation amount and total charges.\\u003cbr/\\u003e\",\"priceType\":\"commission\",\"commission\":[{\"amount\":0,\"currency\":\"USD\"}],\"retailRate\":{\"total\":[{\"amount\":674.89,\"currency\":\"USD\"}],\"suggestedSellingPrice\":[{\"amount\":786.92,\"currency\":\"USD\",\"sour