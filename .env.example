NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
AI_API_KEY=
# Fallback for AI_API_KEY when using OpenAI directly.
OPENAI_API_KEY=
# Primary chat provider: "openai", "cerebras" (fastest — gpt-oss), or "gemini".
# The RESOLVE + COMPOSE stages fail over from here to AI_FALLBACK_PROVIDERS on a
# provider error (network / 401 / 403 / 429 / 5xx). gpt-oss's harmony reasoning
# channel is held back from the live stream by a gate, so cerebras is safe as primary.
AI_PROVIDER=cerebras
# Comma list tried in order when the primary fails; a provider with no key is skipped.
AI_FALLBACK_PROVIDERS=gemini,openai
CEREBRAS_API_KEY=
# Google Gemini. On its own it can be the primary provider (AI_PROVIDER=gemini).
GEMINI_API_KEY=
# Gemini retires pinned model ids often (2.0-flash, 2.5-flash, 2.5-pro all 404 now), so use
# an alias like "gemini-flash-latest". GEMINI_MODEL is required for Gemini to be used as a
# RESOLVE/COMPOSE fallback at all — without it the fallback slot is skipped as a dead end.
GEMINI_MODEL=gemini-flash-latest
# The model for cheap bulk work (web-page import, event/hotel summaries, thread summary).
# Only when set does that work route to Gemini; blank keeps it on the primary provider.
GEMINI_BULK_MODEL=gemini-flash-latest
# Chat/compose model. Blank = the provider default (gpt-oss-120b for cerebras,
# gpt-4o for openai). Do not set gpt-4o while AI_PROVIDER=cerebras — Cerebras
# rejects it (400) and every turn silently falls through to Gemini.
AI_MODEL=
# Turn-planning (RESOLVE) model. Blank = same as AI_MODEL / provider default.
RESOLVE_MODEL=
# Optional: a cheap model for the rolling conversation summary. Defaults to AI_MODEL.
SUMMARY_MODEL=
# Optional: embeddings model for the recommendation system (detail-page "more like this").
# Always uses the OpenAI provider key (AI_API_KEY / OPENAI_API_KEY). Default text-embedding-3-small.
EMBED_MODEL=
AI_BASE_URL=
# Optional: log the resolved turn plan and provider shapes to stdout (never in production).
AI_DEBUG=
TAVILY_API_KEY=
# Ticketmaster Discovery API key (either name is read).
TICKETMASTER_API_KEY=
TICKETMASTER_CONSUMER_KEY=
# Eventbrite private token (Bearer). Local/community events via destination search.
EVENTBRITE_API_KEY=
# GetYourGuide Partner API token (sent as X-ACCESS-TOKEN). Requires an approved
# partner account. Adds bookable tours & activities to the assistant's "events" results.
GETYOURGUIDE_API_KEY=
# PredictHQ access token (Bearer). Event-intelligence API — adds broad coverage, a real
# date-range filter, and a 0-100 "local_rank" + predicted attendance used to order the
# "what's on?" list and badge major events. Optional; no ticket links (web-search fallback).
PREDICTHQ_API_KEY=
OPENWEATHER_API_KEY=
TRANSIT_API_KEY=
# Duffel access token (test or live). Live flight fare estimates for "how much to fly" turns.
DUFFEL_API_KEY=
# LiteAPI (Nuitee) key - sandbox sand_... or prod prod_.... Live hotel inventory, nightly
# rates, hotel details and room rates. Also read from CONNECT_API_KEY if set.
LITEAPI_KEY=
CONNECT_API_KEY=
# Optional: ISO country code sent as guestNationality on LiteAPI rate requests (default US).
LITEAPI_GUEST_NATIONALITY=
# Optional: Redis connection URL (redis:// or rediss://). When set, provider/API caching is
# shared across instances; when empty, an in-process cache is used.
REDIS_URL=
# Playwright only: enables the credential-free /trips/rebuild-preview route. Never set in production.
E2E_PREVIEW=
# Postgres session-pooler URL, used ONLY by `bun run db:migrate` (the `@` in the password
# must stay percent-encoded as %40).
DATABASE_URL=
# Public origin, used to build absolute URLs in robots.txt / sitemap.xml and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Sentry DSN. When set at build time the Sentry SDK is wired in; with no DSN it is
# absent from the bundle entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# Bearer token required by POST /api/cron/trip-review (scheduled trip-review warmer).
CRON_SECRET=
# Resend transactional email. When both are set, trip invites with an email address
# are sent; otherwise the invite link is returned for the owner to share by hand.
RESEND_API_KEY=
EMAIL_FROM="Where next? <invites@yourdomain.com>"
