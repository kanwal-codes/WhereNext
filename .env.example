NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Vercel AI Gateway — the single boundary every AI call in this app goes through (RESOLVE,
# COMPOSE, and every "bulk" block-builder/summariser). One key, automatic per-model fallback,
# Gateway-side observability/spend tracking. Get one at https://vercel.com/dashboard (AI Gateway).
AI_GATEWAY_API_KEY=
# Per-role model overrides, as Vercel AI Gateway ids ("vendor/model", e.g.
# "anthropic/claude-sonnet-5", "google/gemini-3.8-flash"). Blank = the role's built-in default
# chain (see packages/ai/model-policy.ts) — a set override becomes that chain's lead model, the
# built-in defaults remain as its fallback.
#   resolve — turn planning (intent, tool plan). Fast + cheap; gates every turn's latency.
#   compose — the streamed answer the user reads. A writing-quality model, not just a fast one.
#   bulk    — cheap high-context extraction (itinerary/budget/comparison/checklist blocks,
#             thread summaries, trip-import parsing, hotel/event blurb rewrites).
RESOLVE_MODEL=
AI_MODEL=
SUMMARY_MODEL=
# Optional: embeddings model for the recommendation system (detail-page "more like this"),
# also resolved through AI_GATEWAY_API_KEY. Default "openai/text-embedding-3-small".
EMBED_MODEL=
# Optional: log the resolved turn plan and provider shapes to stdout (never in production).
AI_DEBUG=
TAVILY_API_KEY=
# Optional: pilots Exa instead of Tavily for research_web (Phase 5, ~37% faster in an independent
# benchmark, not a clear content-quality win — see packages/providers/exa/client.ts). When set,
# Exa is used instead of Tavily; leave unset to keep Tavily.
EXA_API_KEY=
# Ticketmaster Discovery API key (either name is read).
TICKETMASTER_API_KEY=
TICKETMASTER_CONSUMER_KEY=
# Eventbrite private token (Bearer). Local/community events via destination search.
EVENTBRITE_API_KEY=
# GetYourGuide affiliate deep-link (GetYourGuideCard) — no API key needed, just this partner id
# from https://partner.getyourguide.com/. Outbound link only; the app never fetches or displays
# GetYourGuide's own content (their Partner API integration was removed — affiliate-only, not a
# content partnership). PredictHQ was also removed (paid, not worth it at this scale).
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
OPENWEATHER_API_KEY=
# Optional: pilots Google's Weather API instead of OpenWeather for the live near-term forecast
# (Phase 5, notably cheaper per call — see packages/providers/google-weather/client.ts). When
# set, Google Weather is used instead of OpenWeather; leave unset to keep OpenWeather. Needs
# GOOGLE_MAPS_API_KEY too (geocoding reuses the existing Google Places search).
GOOGLE_WEATHER_API_KEY=
TRANSIT_API_KEY=
# Duffel access token (test or live). Live flight fare estimates for "how much to fly" turns.
# SerpAPI (Google Flights): real fares, place suggestions, round trips. Without it flight search falls back to Duffel's test data.
SERP_API_KEY=
DUFFEL_API_KEY=
# LiteAPI (Nuitee) key - sandbox sand_... or prod prod_.... Live hotel inventory, nightly
# rates, hotel details and room rates. Also read from CONNECT_API_KEY if set.
LITEAPI_KEY=
CONNECT_API_KEY=
# Optional: ISO country code sent as guestNationality on LiteAPI rate requests (default US).
LITEAPI_GUEST_NATIONALITY=
# Optional: Redis connection URL (redis:// or rediss://). When set, provider/API caching is
# shared across instances; when empty, an in-process cache is used.
REDIS_URL=
# Optional: Upstash Redis (HTTP, serverless-friendly) — backs the daily/per-trip AI turn rate
# limits. When set, limits are shared across instances; when empty, an in-process fallback is
# used (resets on deploy — fine for blunting scripted abuse, not a hard security boundary).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Playwright only: enables the credential-free /trips/rebuild-preview route. Never set in production.
E2E_PREVIEW=
# Postgres session-pooler URL, used ONLY by `bun run db:migrate` (the `@` in the password
# must stay percent-encoded as %40).
DATABASE_URL=
# Public origin, used to build absolute URLs in robots.txt / sitemap.xml and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Sentry DSN. When set at build time the Sentry SDK is wired in; with no DSN it is
# absent from the bundle entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# Bearer token required by the scheduled crons (trip-review warmer, fallback-rate monitor).
CRON_SECRET=
# Optional: mailbox to alert when RESOLVE's Cerebras-pin fallback rate crosses
# FALLBACK_RATE_THRESHOLD (default 0.2) — /api/cron/fallback-rate. Unset = check runs and
# logs, no email sent. There's no Slack/webhook integration in this app; email is the only
# notification channel that exists (Phase 2.3, docs/overhaul/roadmap/phase-2-speed.md).
FALLBACK_ALERT_EMAIL=
FALLBACK_RATE_THRESHOLD=
# Resend transactional email. When both are set, trip invites with an email address
# are sent; otherwise the invite link is returned for the owner to share by hand.
RESEND_API_KEY=
EMAIL_FROM="Where next? <invites@yourdomain.com>"
# Splitwise OAuth2 app credentials (register at https://secure.splitwise.com/apps) — shared
# expense logging on the Bookings & essentials tab. Each trip member connects their own account.
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=
# Any secret string — hashed into an AES-256 key used to encrypt Splitwise OAuth tokens at
# rest (splitwise_accounts table). Required once SPLITWISE_CLIENT_ID/SECRET are set.
TOKEN_ENCRYPTION_KEY=

# Optional: Cloudflare Turnstile site key. Turn on CAPTCHA for anonymous sign-ins in Supabase (Auth > Attack Protection) and set the matching site key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: per-IP guest ceilings, counted over 30 days (new guest trips and Roam messages per IP). Defaults are 1 and 10
# in production and 100x that in development, where every visitor is the same IP.
# GUEST_IP_START_LIMIT=1
# GUEST_IP_TURN_LIMIT=10
