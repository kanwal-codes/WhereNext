NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
AI_API_KEY=
# Fallback for AI_API_KEY when using OpenAI directly.
OPENAI_API_KEY=
# Primary chat provider: "openai" (recommended), "cerebras", or "gemini".
# gpt-4o is the safe default — best instruction-following, no reasoning-channel leak.
AI_PROVIDER=openai
CEREBRAS_API_KEY=
# Google Gemini. On its own it can be the primary provider (AI_PROVIDER=gemini);
# even when it is NOT primary, if this key is set the cheap bulk work (web-page
# import, event/hotel summaries, thread summary) automatically routes to Gemini Flash.
GEMINI_API_KEY=
# Optional: override the Gemini model used for that bulk work (default gemini-2.5-flash).
GEMINI_BULK_MODEL=
# Chat/compose model. Blank = the provider default (gpt-4o for openai).
AI_MODEL=gpt-4o
# Turn-planning (RESOLVE) model. Tool selection is unreliable on weak models —
# keep this at gpt-4o even if AI_MODEL is set cheaper.
RESOLVE_MODEL=gpt-4o
# Optional: a cheap model for the rolling conversation summary. Defaults to AI_MODEL.
SUMMARY_MODEL=
AI_BASE_URL=
# Optional: log the resolved turn plan and provider shapes to stdout (never in production).
AI_DEBUG=
TAVILY_API_KEY=
# Ticketmaster Discovery API key (either name is read).
TICKETMASTER_API_KEY=
TICKETMASTER_CONSUMER_KEY=
# Eventbrite private token (Bearer). Local/community events via destination search.
EVENTBRITE_API_KEY=
# GetYourGuide Partner API token (sent as X-ACCESS-TOKEN). Requires an approved
# partner account. Adds bookable tours & activities to the assistant's "events" results.
GETYOURGUIDE_API_KEY=
OPENWEATHER_API_KEY=
TRANSIT_API_KEY=
# Duffel access token (test or live). Live flight fare estimates for "how much to fly" turns.
DUFFEL_API_KEY=
# LiteAPI (Nuitee) key - sandbox sand_... or prod prod_.... Live hotel inventory, nightly
# rates, hotel details and room rates. Also read from CONNECT_API_KEY if set.
LITEAPI_KEY=
CONNECT_API_KEY=
# Optional: ISO country code sent as guestNationality on LiteAPI rate requests (default US).
LITEAPI_GUEST_NATIONALITY=
# Optional: Redis connection URL (redis:// or rediss://). When set, provider/API caching is
# shared across instances; when empty, an in-process cache is used.
REDIS_URL=
# Playwright only: enables the credential-free /trips/rebuild-preview route. Never set in production.
E2E_PREVIEW=
# Postgres session-pooler URL, used ONLY by `bun run db:migrate` (the `@` in the password
# must stay percent-encoded as %40).
DATABASE_URL=
# Public origin, used to build absolute URLs in robots.txt / sitemap.xml and share links.
NEXT_PUBLIC_SITE_URL=
# Optional: Sentry DSN. When set at build time the Sentry SDK is wired in; with no DSN it is
# absent from the bundle entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# Bearer token required by POST /api/cron/trip-review (scheduled trip-review warmer).
CRON_SECRET=
# Resend transactional email. When both are set, trip invites with an email address
# are sent; otherwise the invite link is returned for the owner to share by hand.
RESEND_API_KEY=
EMAIL_FROM="Where next? <invites@yourdomain.com>"
