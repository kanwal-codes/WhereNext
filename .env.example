NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
AI_API_KEY=
AI_PROVIDER=openai-compatible
CEREBRAS_API_KEY=
AI_MODEL=
# Optional: a stronger model for the turn-planning (RESOLVE) call only. On weak
# base models (e.g. gpt-4o-mini) tool selection is unreliable; set gpt-4o here.
RESOLVE_MODEL=
# Optional: a cheap model for the rolling conversation summary. Defaults to AI_MODEL.
SUMMARY_MODEL=
AI_BASE_URL=
TAVILY_API_KEY=
TICKETMASTER_CONSUMER_KEY=
TICKETMASTER_CONSUMER_SECRET=
# Eventbrite private token (Bearer). Local/community events via destination search.
EVENTBRITE_API_KEY=
OPENWEATHER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
TRANSIT_API_KEY=
# Duffel access token (test or live). Live flight fare estimates for "how much to fly" turns.
DUFFEL_API_KEY=
# LiteAPI (Nuitee) key - sandbox sand_... or prod prod_.... Live hotel inventory +
# nightly rates for "where should we stay". Also read from CONNECT_API_KEY if set.
LITEAPI_KEY=
